classDiagram
  class Пользователь {
    id
    username
    role
  }
  class Коктейль {
    id
    name
    category
  }
  class Рецепт {
    id
    type
    is_completed
  }
  class Ингредиент {
    id
    name
    volume
  }
  class ПриготовленныйКоктейль {
    id
    prepared_at
  }

  Пользователь "1" --> "*" ПриготовленныйКоктейль : отмечает
  Коктейль "1" --> "*" ПриготовленныйКоктейль : отмечается
  Коктейль "1" --> "*" Рецепт : имеет
  Рецепт "*" --> "*" Ингредиент : состоит из
